# ── the daemon ───────────────────────────────────────────────────────────────

class Daemon:
    """One connection; replies matched by id, events handed to `on_event`."""

    def __init__(self, on_event=None):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            self.sock.connect(SOCK)
        except OSError:
            subprocess.run(["systemctl", "--user", "start", "quarryd"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for _ in range(50):
                time.sleep(0.1)
                try:
                    self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    self.sock.connect(SOCK)
                    break
                except OSError:
                    continue
            else:
                sys.exit(f"quarry term: the daemon is not running ({SOCK})")
        self.on_event = on_event
        self.lock = threading.Lock()
        self.next_id = 0
        self.waiting = {}
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self):
        buf = b""
        while True:
            try:
                chunk = self.sock.recv(1 << 16)
            except OSError:
                chunk = b""
            if not chunk:
                for slot in list(self.waiting.values()):
                    slot[1] = {"ok": False, "err": "daemon closed the connection"}
                    slot[0].set()
                return
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if msg.get("t") == "ev":
                    if self.on_event:
                        self.on_event(msg.get("m"), msg.get("p"))
                    continue
                slot = self.waiting.pop(msg.get("id"), None)
                if slot:
                    slot[1] = msg
                    slot[0].set()

    def call(self, method, params=None, timeout=120):
        with self.lock:
            self.next_id += 1
            rid = self.next_id
            slot = [threading.Event(), None]
            self.waiting[rid] = slot
            frame = {"t": "req", "id": rid, "m": method, "p": params or {}}
            self.sock.sendall((json.dumps(frame) + "\n").encode())
        if not slot[0].wait(timeout):
            self.waiting.pop(rid, None)
            raise RuntimeError(f"{method}: no answer in {timeout}s")
        msg = slot[1]
        if not msg.get("ok"):
            raise RuntimeError(f"{method}: {msg.get('err') or 'failed'}")
        return msg.get("p") or {}


# ── pictures ─────────────────────────────────────────────────────────────────

def detect_gfx():
    if os.environ.get("QUARRY_TERM_GFX"):
        return os.environ["QUARRY_TERM_GFX"]
    if os.environ.get("ZEIT_PANE") or os.environ.get("TMUX"):
        return "blocks"
    if os.environ.get("TERM") == "xterm-kitty" or os.environ.get("TERM_PROGRAM") in ("kitty", "zash"):
        return "kitty"
    return "blocks"


def fit(img, cols, rows, px_per_row=2):
    """Scale into a cols×(rows·px_per_row) box, keeping the shape."""
    w, h = img.size
    box_w, box_h = cols, rows * px_per_row
    s = min(box_w / max(w, 1), box_h / max(h, 1))
    return img.resize((max(1, round(w * s)), max(1, round(h * s))), Image.LANCZOS)


def blocks(img, cols, rows):
    """Lines of exactly `cols` cells, the picture centred in a cols×rows box."""
    img = fit(img.convert("RGBA"), cols, rows)
    w, h = img.size
    px = img.load()
    left = (cols - w) // 2
    top = (rows * 2 - h) // 2
    top -= top % 2  # keep pixel rows paired on cell boundaries

    def at(x, y):
        x -= left
        y -= top
        if 0 <= x < w and 0 <= y < h:
            r, g, b, a = px[x, y]
            if a >= 96:
                return r, g, b
        return None

    lines = []
    for row in range(rows):
        out, fg, bg = [], None, None
        for x in range(cols):
            t, b = at(x, row * 2), at(x, row * 2 + 1)
            if t is None and b is None:
                ch, nfg, nbg = " ", fg, "49"
            elif b is None:
                ch, nfg, nbg = "▀", "38;2;%d;%d;%d" % t, "49"
            elif t is None:
                ch, nfg, nbg = "▄", "38;2;%d;%d;%d" % b, "49"
            else:
                ch, nfg, nbg = "▀", "38;2;%d;%d;%d" % t, "48;2;%d;%d;%d" % b
            codes = []
            if nfg != fg:
                codes.append(nfg)
                fg = nfg
            if nbg != bg:
                codes.append(nbg)
                bg = nbg
            if codes:
                out.append("\x1b[" + ";".join(codes) + "m")
            out.append(ch)
        out.append("\x1b[0m")
        lines.append("".join(out))
    return lines


def solid(hexcolor, cols, rows):
    """A loading tile in the picture's dominant colour, the way the app fills it."""
    m = re.fullmatch(r"#?([0-9a-fA-F]{6})", hexcolor or "")
    if not m:
        return [" " * cols for _ in range(rows)]
    r, g, b = (int(m.group(1)[i:i + 2], 16) for i in (0, 2, 4))
    return ["\x1b[48;2;%d;%d;%dm%s\x1b[0m" % (r // 2, g // 2, b // 2, " " * cols)] * rows


def frames_of(path, box):
    """Every frame (composited) as (image, seconds), shrunk to the box first."""
    img = Image.open(path)
    out = []
    for i, frame in enumerate(ImageSequence.Iterator(img)):
        if i >= MAX_FRAMES:
            break
        f = frame.convert("RGBA")
        f.thumbnail(box, Image.LANCZOS)
        out.append((f, max(0.02, (frame.info.get("duration") or 100) / 1000)))
    return out


class Kitty:
    """Placements by file path. Each slot keeps one image id so a frame replaces it."""

    def __init__(self, out):
        self.out = out

    def png(self, img):
        os.makedirs(CACHE, exist_ok=True)
        key = hashlib.sha1(img.tobytes() + repr(img.size).encode()).hexdigest()[:20]
        path = os.path.join(CACHE, f"k-{key}.png")
        if not os.path.exists(path):
            img.convert("RGBA").save(path)  # zash wants 8-bit, not indexed
        return path

    def place(self, slot, img, col, row, cols, rows):
        path = self.png(img)
        w, h = img.size
        # Shrink the cell box to the picture's shape so it is not stretched;
        # a cell is about twice as tall as it is wide.
        s = min(cols / max(w, 1), rows * 2 / max(h, 1))
        c, r = max(1, round(w * s)), max(1, round(h * s / 2))
        col += (cols - c) // 2
        row += (rows - r) // 2
        data = base64.b64encode(path.encode()).decode()
        return (f"\x1b_Ga=d,d=i,i={slot},q=2\x1b\\\x1b[{row + 1};{col + 1}H"
                f"\x1b_Ga=T,f=100,t=f,i={slot},c={c},r={r},C=1,q=2;{data}\x1b\\")

    @staticmethod
    def clear():
        return "\x1b_Ga=d,d=A,q=2\x1b\\"


# ── items ────────────────────────────────────────────────────────────────────

def is_video(it):
    return it.get("family") == "video" or (it.get("ext") or "").lower() in VIDEO_EXT


def is_audio(it):
    return it.get("family") == "audio" or (it.get("ext") or "").lower() in AUDIO_EXT


def moves(it):
    return bool(it.get("animated")) and not is_video(it)


def fetch_original(it):
    """The file itself, for animation: the thumbnail ladder is still frames."""
    url = it.get("url") or ""
    ext = (it.get("ext") or "bin").lower()
    os.makedirs(CACHE, exist_ok=True)
    path = os.path.join(CACHE, hashlib.sha1(url.encode()).hexdigest()[:24] + "." + ext)
    if os.path.exists(path):
        return path
    headers = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) quarry-term"}
    if it.get("page_url"):
        headers["Referer"] = it["page_url"]
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=25) as r:
        data = r.read(40 << 20)
    tmp = path + ".part"
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, path)
    return path


